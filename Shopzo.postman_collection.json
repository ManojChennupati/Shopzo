      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "Paste your JWT token here after logging in"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string",
      "description": "Set a valid product ID from GET /products"
    },
    {
      "key": "orderId",
